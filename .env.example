APP_NAME="Claude tool-use sample"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Claude. Only ANTHROPIC_API_KEY is needed; without it the SDK tries
# ANTHROPIC_AUTH_TOKEN and an `ant auth login` profile.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_TOKENS=16000
# CLAUDE_MAX_ITERATIONS=8
# CLAUDE_FALLBACKS=true
# CLAUDE_USAGE_LOG_CHANNEL=claude_usage
